APP_NAME=Meeting Intelligence & Accountability System
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_intelligence

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=small

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500

ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.aac,.flac,.ogg,.webm
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-this-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

MAX_TRANSCRIPT_SEGMENTS=10000
MAX_MEETING_TITLE_LENGTH=255